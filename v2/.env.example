# ── Fuentes ──────────────────────────────────────────────────────────────
# Google Cloud: habilitar "Places API (New)" (la v1 usaba la API legacy).
GOOGLE_PLACES_API_KEY=
# Opcional. Sin clave se usa solo el sitio web para el decisor.
APOLLO_API_KEY=
# Revelar emails enmascarados gasta 1 crédito por persona. Default: false.
APOLLO_REVEAL_EMAILS=false

# ── Precalificación IA ───────────────────────────────────────────────────
# Sin clave el pipeline usa solo reglas (segment/strategy/gancho por plantilla).
ANTHROPIC_API_KEY=
# Sonnet por costo (≈$2/$10 por MTok). Para más calidad: claude-opus-5-5.
ANTHROPIC_MODEL=claude-sonnet-5-5
# low | medium | high — extracción simple, low alcanza.
ANTHROPIC_EFFORT=low

# ── CRM ──────────────────────────────────────────────────────────────────
CRM_BASE_URL=https://mbguiaclientes.lovable.app
# El mismo secreto de ⚡ Integraciones (integration_settings.webhook_secret).
CRM_WEBHOOK_SECRET=

# ── Zona objetivo ────────────────────────────────────────────────────────
# Estado que debe tener la dirección ('' = no validar estado).
TARGET_STATE=FL
# Ciudades (coma). Vacío = listas por defecto de config.py (sur de Florida).
TARGET_CITIES=
# Por estrategia (gana sobre TARGET_CITIES):
# TARGET_CITIES_ONSITE=Miami Beach,Sunny Isles Beach,Aventura
# TARGET_CITIES_PAIN=
# TARGET_CITIES_PORTFOLIO=Miami,Doral,Coral Gables
# OpenStreetMap: south,west,north,east (default Miami-Dade + Broward)
# OSM_BBOX=25.55,-80.50,26.35,-80.05

# ── Enriquecimiento profundo ─────────────────────────────────────────────
# Reseñas de Google (con fecha) para el detector de dolor; SKU Atmosphere (~US$0,005 más por página).
PLACES_REVIEWS=true
# Perfil físico desde OpenStreetMap (pisos, huella, techo, amenities, costa). Gratis.
GEO_ENABLED=true
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# Renderizado JS de sitios SPA con Playwright: off | auto (solo si el HTML viene vacío) | always
RENDER_JS=auto
# PLAYWRIGHT_CHROMIUM_PATH=/opt/pw-browsers/chromium
# Búsqueda web externa (solo APIs oficiales). auto = la primera con clave; off = desactivada.
SEARCH_PROVIDER=auto
SERPAPI_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
BRAVE_SEARCH_KEY=
# Padrón oficial de condominios + licencias CAM del DBPR (python -m lead_engine dbpr-sync). MD=Dade/Monroe, PB=Broward/Palm Beach.
DBPR_GROUPS=MD,PB
# Semilla DBPR (--seed dbpr, o automática si no hay GOOGLE_PLACES_API_KEY): mínimo de unidades y tamaño que va primero.
MIN_UNITS=50
PRIORITY_UNITS=80
# Condados (grafía DBPR) que cuentan como "la zona" para el cluster multi-propiedad.
CLUSTER_COUNTIES=Dade,Broward,Palm Beach
# Catastro oficial (Miami-Dade Property Appraiser, ArcGIS público): año, pisos, ft², propietario, valor; ventana Milestone.
APPRAISER_ENABLED=true
# NPI Registry (CMS, público) para el segmento Clínica/Hospital.
NPI_ENABLED=true
# --seed pa: segmento a sembrar desde el catastro (plaza | commercial | clinic) y superficie mínima.
SEED_VERTICAL=plaza
SEED_MIN_SQFT=20000
# Dominios extra de administradoras (JSON {"Firma": "dominio.com"}), además del catálogo curado.
# MGMT_DOMAINS_FILE=./mgmt_domains.json
# segment del CRM: "pain" (Dolor Urgente / Gran Comunidad, lo que acepta hoy el CRM) o "vertical"
# (Gran Comunidad / Shopping/Plaza Comercial / Edificio Comercial / Clínica/Hospital) cuando el CRM los acepte.
CRM_SEGMENT_MODE=pain
# Señales municipales (open data ArcGIS: City of Miami recertificación 40 años, Miami-Dade violaciones y permisos).
MUNICIPAL_SIGNALS=true
# Validación DNS/MX de emails (descarta dominios inexistentes o sin correo).
EMAIL_MX_CHECK=true
# Agrega la línea «Ficha: …» (pisos, m², amenities, teléfonos, score) al sales_strategy del CRM.
CRM_INCLUDE_BRIEF=true
# Precios para el costo estimado del quality_report (USD por unidad), ej.:
# PRICE_SERPAPI=0.015  PRICE_PLACES_TEXT_SEARCH_REVIEWS=0.040  PRICE_CLAUDE_INPUT_TOKEN=0.000002

# ── Opcionales ───────────────────────────────────────────────────────────
# LEAD_ENGINE_OUT=./out
# LEAD_ENGINE_DB=./data/state.db
# HTTP_TIMEOUT_S=12
