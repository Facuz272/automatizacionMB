# ── Fuentes ──────────────────────────────────────────────────────────────
# Google Cloud: habilitar "Places API (New)" (la v1 usaba la API legacy).
GOOGLE_PLACES_API_KEY=
# Opcional. Sin clave se usa solo el sitio web para el decisor.
APOLLO_API_KEY=
# Revelar emails enmascarados gasta 1 crédito por persona. Default: false.
APOLLO_REVEAL_EMAILS=false

# ── Precalificación IA ───────────────────────────────────────────────────
# Sin clave el pipeline usa solo reglas (segment/strategy/gancho por plantilla).
ANTHROPIC_API_KEY=
# Sonnet por costo (≈$2/$10 por MTok). Para más calidad: claude-opus-5-5.
ANTHROPIC_MODEL=claude-sonnet-5-5
# low | medium | high — extracción simple, low alcanza.
ANTHROPIC_EFFORT=low

# ── CRM ──────────────────────────────────────────────────────────────────
CRM_BASE_URL=https://mbguiaclientes.lovable.app
# El mismo secreto de ⚡ Integraciones (integration_settings.webhook_secret).
CRM_WEBHOOK_SECRET=

# ── Zona objetivo ────────────────────────────────────────────────────────
# Estado que debe tener la dirección ('' = no validar estado).
TARGET_STATE=FL
# Ciudades (coma). Vacío = listas por defecto de config.py (sur de Florida).
TARGET_CITIES=
# Por estrategia (gana sobre TARGET_CITIES):
# TARGET_CITIES_ONSITE=Miami Beach,Sunny Isles Beach,Aventura
# TARGET_CITIES_PAIN=
# TARGET_CITIES_PORTFOLIO=Miami,Doral,Coral Gables
# OpenStreetMap: south,west,north,east (default Miami-Dade + Broward)
# OSM_BBOX=25.55,-80.50,26.35,-80.05

# ── Opcionales ───────────────────────────────────────────────────────────
# LEAD_ENGINE_OUT=./out
# LEAD_ENGINE_DB=./data/state.db
# HTTP_TIMEOUT_S=12
