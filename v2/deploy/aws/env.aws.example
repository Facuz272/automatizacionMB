# /opt/lead-engine/v2/.env en la instancia (chmod 600, dueño leadengine). Nunca se commitea.
# ── claves (obligatorias) ───────────────────────────────────────────────────
GOOGLE_PLACES_API_KEY=
ANTHROPIC_API_KEY=
CRM_BASE_URL=https://mbguiaclientes.lovable.app
CRM_WEBHOOK_SECRET=
# Incoming Webhook del canal #operacion (Slack → Apps → Incoming Webhooks)
SLACK_WEBHOOK_URL=
TENANT=mb_softwash

# ── costo mínimo ────────────────────────────────────────────────────────────
# Text Search IDs Only (sin cargo) + Place Details Enterprise solo hasta el primer match
PLACES_MODE=details
PLACES_DETAILS_MAX=2
PLACES_REVIEWS=false
# Sin Nearby Search (gancho de zona por reseñas de vecinos)
COMPETITOR_NEARBY=false
# Claude solo para extraer contacto / administradora del sitio; Haiku cuesta ~US$ 0,0006 por lead
ANTHROPIC_MODEL=claude-haiku-5-5
# Sin Chromium (instancia de 1 GB); "auto" si la instancia tiene 2 GB
RENDER_JS=off

# ── piloto automático ───────────────────────────────────────────────────────
# false = dry run (no escribe en el CRM). Pasar a true cuando el dueño apruebe la facturación.
REPLENISH_COMMIT=false
REPLENISH_FLOOR_DAYS=2
REPLENISH_TARGET_DAYS=3
REPLENISH_MAX_LEADS=400
# Tope a precio de lista por corrida (el costo real es menor por el cupo gratis mensual de Google)
REPLENISH_MAX_COST_USD=10
REPLENISH_MIX={"condo_onsite": 0.40, "condo_portfolio": 0.25, "cab_firm": 0.35}
